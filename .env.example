# Conexão Postgres (Supabase: pooler em modo transação, porta 6543, usuário nautilus_app.<ref>).
DATABASE_URL=
# Senha padrão de primeiro acesso exibida aos gestores. Obrigatória em produção.
DEFAULT_PASSWORD=
# Endereço público do site (usado nos links dos e-mails).
APP_URL=
# Protege /api/cron/notifications (a Vercel envia automaticamente nos crons).
CRON_SECRET=
# E-mails (Resend). EMAIL_ENABLED=true ativa os avisos automáticos.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ENABLED=false
